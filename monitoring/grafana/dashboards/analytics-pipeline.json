      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 15 },
      "id": 9,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max", "mean"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(analytics_event_end_to_end_seconds_bucket[1m])))", "legendFormat": "p50 E2E Latency", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(analytics_event_end_to_end_seconds_bucket[1m])))", "legendFormat": "p95 E2E Latency", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(analytics_event_end_to_end_seconds_bucket[1m])))", "legendFormat": "p99 E2E Latency", "refId": "C" }
      ],
      "title": "End-to-End Latency (receivedAt to DB persisted)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2 },
